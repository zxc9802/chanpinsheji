# Primary image provider: fal.ai GPT Image 2.5 Sunburst, quality high.
FAL_KEY=
# FAL_GPT_IMAGE2_API_KEY is also accepted for existing deployments.

OPENLUX_API_KEY=
OPENLUX_BASE_URL=https://api.openlux.ai/v1
OPENLUX_MODEL=gpt-5.6-luna

# Automatic region recognition only; key falls back to OPENLUX_API_KEY.
REGION_VISION_API_KEY=
REGION_VISION_BASE_URL=https://api.openlux.ai
REGION_VISION_MODEL=gemini-3.7-flash

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

YUNWU_API_KEY=
YUNWU_BASE_URL=https://yunwu.ai
YUNWU_MODEL=gemini-3.1-flash-lite
YUNWU_IMAGE_MODEL=gpt-image-2
YUNWU_IMAGE_SIZE=1024x1024
YUNWU_IMAGE_QUALITY=low

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_MODEL=

AI_PROVIDER_COPY=deepseek
AI_PROVIDER_IMAGE=fal

